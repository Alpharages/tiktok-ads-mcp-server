# TikTok Ads API Configuration
# Get these credentials from TikTok For Business Developer Portal
# https://business-api.tiktok.com/portal/

# Required: TikTok App credentials
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# Remote (Streamable HTTP) hosting — used by tiktok_ads_mcp.http_server
# Required when running the HTTP server (the default Docker CMD / docker-compose).
# Shared bearer token remote MCP clients must send as `Authorization: Bearer <token>`.
# Generate a strong value, e.g.:  openssl rand -hex 32
MCP_AUTH_TOKEN=
# Optional: bind address / port for the HTTP server (defaults shown).
HOST=0.0.0.0
PORT=8000

# Optional: Logging configuration
LOG_LEVEL=INFO
LOG_FILE=tiktok_ads_mcp.log

# Optional: API Rate limiting
RATE_LIMIT_REQUESTS_PER_HOUR=900
RATE_LIMIT_CONCURRENT_REQUESTS=8

# Optional: Default report settings
DEFAULT_REPORT_TIMEOUT_MINUTES=10
DEFAULT_DATE_RANGE=last_7_days

# Development settings
DEVELOPMENT_MODE=false
DEBUG_API_REQUESTS=false